# ==============================================================================
# Contractor Lead-Generation Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` to override default settings for local development.
# Note: No commercial APIs or third-party paid services are required.

# --- Target Execution Defaults ---
# Default contractor category to target (e.g. Roofing, HVAC, Plumbing, Landscaping, Hardscaping, Remodeling, Pest Control, Med Spa)
SCRAPER_SELECTED_CATEGORY=Roofing

# Default U.S. State (2-letter postal code, e.g. TX, CA, FL, NY) or leave blank for interactive selection
SCRAPER_SELECTED_STATE=TX

# --- Performance & Concurrency Settings ---
# Maximum concurrent async requests/workers for I/O operations
SCRAPER_CONCURRENCY_LIMIT=10

# Request timeout in seconds for network calls
SCRAPER_REQUEST_TIMEOUT_SECONDS=15.0

# Number of retry attempts on network or transient failures
SCRAPER_RETRY_COUNT=3

# Rate limit: maximum requests dispatched per second
SCRAPER_RATE_LIMIT_PER_SECOND=5.0

# Custom HTTP User-Agent header for public data acquisition
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36 (LeadEngine/0.1.0)"

# --- Optional Commercial Search & Enrichment APIs ---
# To maximize discovery accuracy and eliminate web scraping bot-blocks, configure one of the following:
# 1. Google Custom Search JSON API (100 free queries/day):
# SCRAPER_GOOGLE_SEARCH_API_KEY=your_google_api_key_here
# SCRAPER_GOOGLE_SEARCH_CX=your_custom_search_engine_cx_here
#
# 2. Serper.dev Google Search API (2,500 free queries on signup):
# SCRAPER_SERPER_API_KEY=your_serper_api_key_here
#
# 3. SerpApi:
# SCRAPER_SERPAPI_API_KEY=your_serpapi_key_here

# --- Storage & File Paths ---
# SQLite persistent relational database path for checkpointing and transactional records
SCRAPER_DATABASE_PATH=data/contractor_engine.db

# DuckDB analytical database path for high-throughput aggregations and queries
SCRAPER_DUCKDB_PATH=data/analytics.duckdb

# Directory paths for raw inputs, intermediate states, outputs, and HTTP cache
SCRAPER_RAW_DATA_DIR=data/raw
SCRAPER_PROCESSED_DATA_DIR=data/processed
SCRAPER_OUTPUT_DIR=data/output
SCRAPER_CACHE_DIR=data/cache

# --- Logging & Diagnostics ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SCRAPER_LOG_LEVEL=INFO

# Directory where structured log files are written
SCRAPER_LOGS_DIR=logs

# Enable structured JSON log formatting for log files (true/false)
SCRAPER_JSON_LOG_ENABLED=true
